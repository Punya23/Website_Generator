# Copy to .env and fill in any free keys you have — then: npm run playground
#
# Free-first LLM chain (automatic): Groq → Ollama → Mistral → OpenRouter → OpenAI
# You do not have to set LLM_PROVIDER if GROQ_API_KEY is present. The client
# switches on 401 / credit 402 / exhausted retries and never retries a dead key.

# ── Groq (free tier — preferred when present) ────────────────────────────────
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_COMPOSITION_MODEL=llama-3.3-70b-versatile
# GROQ_SECTION_MODEL=llama-3.1-8b-instant
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_REQUEST_DELAY_MS=600

# ── Ollama (free local testing — no API key) ─────────────────────────────────
# Requires: ollama serve && ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_COMPOSITION_MODEL=llama3.1:8b
# OLLAMA_SECTION_MODEL=llama3.1:8b          # or qwen2.5-coder:7b for faster (weaker copy)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# SKIP_VISION=1                             # local models have no vision — required for Ollama

# ── Ollama Cloud (ingest mapper + optional generation) ───────────────────────
# Get key: https://ollama.com/settings/keys
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_INGEST_MODEL=gpt-oss:20b

# ── Catalog ingest (GitHub discovery → recipe skins) ─────────────────────────
# GITHUB_TOKEN=                             # required for searching thousands of MIT/Apache templates
# INGEST_AUTO_APPROVE=1                    # auto-approve when license + confidence pass
# INGEST_MIN_CONFIDENCE=0.7
# INGEST_CONCURRENCY=4
# INGEST_MAX_PER_RUN=250
# INGEST_USE_LLM=1                          # 0 = heuristic mapping only
# INGEST_SEARCH_PAGES=3                     # GitHub result pages per query (100 hits each, max 10)
# INGEST_MAX_QUERIES=120                    # hard cap on search queries per discovery run
# INGEST_SEARCH_DELAY_MS=                   # default 2100 with GITHUB_TOKEN, 6500 without
# INGEST_DRY_QUERIES=12                     # stop after N queries that return nothing new
# INGEST_SIGNATURE_CAP=4                    # approved skins allowed per layout cluster
# INGEST_SCREENSHOT=needed                  # needed | always | never — render a demo only when it changes an outcome
# INGEST_SCREENSHOT_CONCURRENCY=2
# INGEST_SCREENSHOT_TIMEOUT_MS=20000
# INGEST_THUMBS_DIR=                        # default data/thumbs (internal review only, gitignored)

# ── OpenRouter (paid fallback — used after free providers fail) ────────────
# Get key: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Budget stack (~$0.05–0.20/site, ~25–80 sites on $5 — see src/llm/openrouter-models.ts)
# OPENROUTER_MODEL_TIER=budget          # default
# OPENROUTER_MODEL_TIER=balanced        # GLM 4.6 architect + Gemini Flash (~$0.25–0.38/site)
# OPENROUTER_MODEL_TIER=quality         # legacy upgrade tier
# OPENROUTER_ARCHITECT_MODEL=z-ai/glm-4.6
# OPENROUTER_HERO_CODEGEN_MODEL=z-ai/glm-4.6
# Bespoke per-section TSX codegen runs 10-20x per site — defaults to the fast section model
# (Gemini Flash, ~3-8s/call) rather than the slow GLM heroCodegen model (~60-150s/call). Set
# this back to z-ai/glm-4.6 only if you want max codegen fidelity and accept a much slower run.
# OPENROUTER_BESPOKE_CODEGEN_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_COMPOSITION_MODEL=google/gemini-2.5-flash
# OPENROUTER_SECTION_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# OPENROUTER_MAX_TOKENS=2048          # cap per request (avoids OpenRouter 402 on prepaid accounts)
# OPENROUTER_HTTP_REFERER=http://localhost:3847
# OPENROUTER_APP_NAME=website-generator

# Mistral — https://console.mistral.ai/api-keys (free-tier key goes in the chain after Groq/Ollama)
# MISTRAL_API_KEY=
# MISTRAL_VISION_MODEL=mistral-medium-latest

# OpenAI (vision works out of the box with gpt-4o-mini)
# OPENAI_API_KEY=

# Rate limits (applies to all providers)
# LLM_MAX_CONCURRENCY=3                   # default 3; use 4–6 with PIPELINE_FAST=1
# LLM_REQUEST_DELAY_MS=250                # auto 50ms when concurrency ≥ 4
# LLM_MAX_RETRIES=4                         # default 4 (was 8); billing errors never retry
# LLM_MAX_TOKENS=3072                       # global cap override

# Quality pipeline is now the DEFAULT (no flags needed): site architect (GLM), bespoke per-section
# TSX codegen, vision QA on every page, no silent mocks. It costs more and runs slower per site.
# PIPELINE_QUALITY=0                        # explicit opt-out — same effect as PIPELINE_FAST=1 below
# PIPELINE_FAST=1                           # cheaper/faster tier: parallel sections, unified copy+media,
#                                            #   skip director retries, no bespoke section codegen
# PIPELINE_COST_CAP_USD=0.40                # downgrade to Gemini Flash after cap
# SECTION_FILL_CONCURRENCY=6                # sections filled in parallel (default 6 in fast mode)
# PIPELINE_UNIFIED_SECTION=1                # one LLM call per section for copy+media (on by default with FAST)
# PIPELINE_CREATIVE_LLM=1                   # force creative director LLM even in fast mode
# PIPELINE_DIRECTOR_RETRIES=1               # retry chrome/motion/layout on QA fail even in fast mode
# PIPELINE_DOUBLE_REFINE=1                  # second design refine on QA fail even in fast mode
# PIPELINE_PAGE_CODEGEN=1                 # opt into old per-page section composer
# PIPELINE_SKIN_FILL=0                    # disable authored-skin fill (falls back to page codegen)
# CONSUMER_ID=customer-123                # persist used skins so this customer does not repeat
# WEB3FORMS_ACCESS_KEY=                   # optional; otherwise contact forms post via FormSubmit
# OPENROUTER_PAGE_CODEGEN_MODEL=anthropic/claude-sonnet-4
# VISION_QA_HOME_ONLY=1                     # restrict vision QA to the home page only, for cost

# Aggressive cost savings (opt-in — skips some LLM agents, lower quality)
# LLM_BUDGET_MODE=1
# LLM_BUDGET_DESIGN=1                       # keep design LLM when budget mode on
# LLM_BUDGET_DIRECTORS=1                    # keep motion/layout/chrome LLM when budget on
# LLM_BUDGET_CREATIVE=1                     # keep creative director LLM when budget on

# Pipeline
# OUTPUT_MODE=react          # default — Framer-parity Next.js codegen
# OUTPUT_MODE=html           # legacy block/card HTML pipeline

# Vision QA + retry (screenshots via Playwright; needs vision-capable LLM)
# SKIP_VISION=1              # set to disable vision QA entirely (saves ~$0.01–0.03/site)
# SKIP_PLAYWRIGHT_SETUP=1    # skip auto browser install on startup

# Stock photos — Pexels recommended (free key: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Fallbacks without keys: Openverse → Picsum
# PIXABAY_API_KEY=

# PLAYGROUND_PORT=3847
# REACT_BUILD_TIMEOUT_MS=300000
# PIPELINE_JSON_LOG=1

# Supabase hosting (Postgres + Storage) — server-side only
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SITES_BUCKET=sites
# AUTO_PUBLISH=1              # upload out/ to Storage after successful React build
#
# Public buckets serve HTML as plain text (Supabase security). Edge functions are also
# rewritten to text/plain on browser GET — static HTML cannot render on Supabase URLs.
# Use Cloudflare Pages for a live rendered site (free):
#   npx wrangler login
#   npm run hosting:pages -- 2n-fitness
# Live URL: https://main.wg-2n-fitness.pages.dev/preview/
#
# SUPABASE_SITE_FUNCTION=serve-site   # optional API/asset proxy only — not for HTML preview
# Then deploy: npm run supabase:deploy-site
# SITE_PUBLIC_BASE_URL=https://{slug}.yourplatform.com
